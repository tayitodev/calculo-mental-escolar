---
// src/pages/resultados.astro
---
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Panel Analítico Docente</title>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  </head>
  <body style="background-color: #f4f6f9; font-family: sans-serif; padding: 40px 20px; margin: 0;">

    <!-- PANEL DE CONFIGURACIÓN DE LÍMITES -->
    <div style="background: white; padding: 20px; border-radius: 12px; margin-bottom: 30px; box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1); border: 1px solid #e2e8f0; display: inline-block;">
      <h3 style="margin-top: 0; color: #1e293b; font-size: 16px;">⏱️ Configurar cierre de exámenes (Semana 1)</h3>
      <div style="display: flex; gap: 20px; align-items: flex-end; flex-wrap: wrap;">
        <div>
          <label style="display: block; font-size: 13px; color: #64748b; margin-bottom: 5px;">Límite Lenguajes:</label>
          <input type="datetime-local" id="limite-lenguajes-sem1" style="padding: 8px; border: 1px solid #cbd5e1; border-radius: 6px; font-family: inherit; color: #334155;">
        </div>

        <div>
          <label style="display: block; font-size: 13px; color: #64748b; margin-bottom: 5px;">Límite Matemáticas:</label>
          <input type="datetime-local" id="limite-matematicas-sem1" style="padding: 8px; border: 1px solid #cbd5e1; border-radius: 6px; font-family: inherit; color: #334155;">
        </div>

        <div>
          <label style="display: block; font-size: 13px; color: #64748b; margin-bottom: 5px;">Límite Ciencias:</label>
          <input type="datetime-local" id="limite-ciencias-sem1" style="padding: 8px; border: 1px solid #cbd5e1; border-radius: 6px; font-family: inherit; color: #334155;">
        </div>

        <button id="btn-guardar-limites" style="background: #3b82f6; color: white; border: none; padding: 10px 20px; border-radius: 6px; font-weight: bold; cursor: pointer; transition: 0.2s;">
          Guardar Fechas
        </button>
      </div>
      <p style="margin: 10px 0 0 0; font-size: 12px; color: #94a3b8;">Deja el campo vacío si el examen estará siempre abierto.</p>
    </div>

    <div style="max-width: 1000px; margin: 0 auto; background: white; padding: 30px; border-radius: 16px; box-shadow: 0 10px 25px rgba(0,0,0,0.08);">
      
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 25px; border-bottom: 2px solid #f1f5f9; padding-bottom: 15px;">
        <div>
          <h2 style="color: #1e293b; margin: 0 0 5px 0;">Panel Analítico de Resultados</h2>
          <p style="color: #64748b; font-size: 14px; margin: 0;">Desglose de calificaciones, respuestas y control del grupo</p>
        </div>
        <a href="/" style="background-color: #ef4444; color: white; padding: 8px 16px; border-radius: 6px; text-decoration: none; font-size: 14px; font-weight: bold;">Salir</a>
      </div>

      <!-- Menú de Pestañas -->
      <div style="display: flex; gap: 10px; margin-bottom: 30px; border-bottom: 2px solid #e2e8f0; flex-wrap: wrap;">
        <button id="tab-calculo" style="background: white; border: none; border-bottom: 3px solid #2563eb; color: #2563eb; padding: 10px 20px; font-size: 16px; font-weight: bold; cursor: pointer;">🧮 Cálculo Mental</button>
        <button id="tab-lenguajes" style="background: white; border: none; border-bottom: 3px solid transparent; color: #64748b; padding: 10px 20px; font-size: 16px; font-weight: bold; cursor: pointer;">📖 Lenguajes</button>
        <button id="tab-saberes" style="background: white; border: none; border-bottom: 3px solid transparent; color: #64748b; padding: 10px 20px; font-size: 16px; font-weight: bold; cursor: pointer;">🔬 Saberes</button>
        <button id="tab-lenguajes-sem1" style="background: white; border: none; border-bottom: 3px solid transparent; color: #64748b; padding: 10px 20px; font-size: 16px; font-weight: bold; cursor: pointer;">📚 Lenguajes (Sem 1)</button>
        <button id="tab-matematicas-sem1" style="background: white; border: none; border-bottom: 3px solid transparent; color: #64748b; padding: 10px 20px; font-size: 16px; font-weight: bold; cursor: pointer;">📐 Matemáticas (Sem 1)</button>
        <button id="tab-ciencias-sem1" style="background: white; border: none; border-bottom: 3px solid transparent; color: #64748b; padding: 10px 20px; font-size: 16px; font-weight: bold; cursor: pointer;">🌿 Ciencias (Sem 1)</button>
      </div>

      <!-- ================= VISTA: CÁLCULO MENTAL ================= -->
      <div id="vista-calculo" style="display: block;">
        
        <!-- Promedio General Cálculo -->
        <div style="background-color: #f0fdf4; border: 1px solid #bbf7d0; color: #166534; padding: 15px; border-radius: 8px; text-align: center; margin-bottom: 20px;">
          <h3 style="margin: 0; font-size: 16px; color: #15803d;">Promedio General del Grupo (Cálculo)</h3>
          <p style="margin: 5px 0 0 0; font-size: 28px; font-weight: bold;" id="txt-promedio-calculo">--</p>
        </div>

        <div style="margin-bottom: 40px; background: #f8fafc; padding: 20px; border-radius: 12px; border: 1px solid #e2e8f0;">
          <div style="display: flex; gap: 10px; margin-bottom: 20px; justify-content: center;">
            <button id="btn-vista-general" style="background: #2563eb; color: white; border: none; padding: 10px 20px; border-radius: 8px; cursor: pointer; font-weight: bold;">Rendimiento</button>
            <button id="btn-vista-operaciones" style="background: #e2e8f0; color: #475569; border: none; padding: 10px 20px; border-radius: 8px; cursor: pointer; font-weight: bold;">Aciertos por Operación</button>
            <button id="btn-vista-tiempos" style="background: #e2e8f0; color: #475569; border: none; padding: 10px 20px; border-radius: 8px; cursor: pointer; font-weight: bold;">Tiempos Promedio</button>
          </div>
          <div style="position: relative; height: 250px; width: 100%;">
            <canvas id="graficaCalificaciones"></canvas>
            <canvas id="grafica-operaciones" style="display: none;"></canvas>
            <canvas id="grafica-tiempos" style="display: none;"></canvas>
          </div>
        </div>

        <h3 style="color: #334155; font-size: 16px; margin-bottom: 15px;">Listado de Alumnos (Cálculo)</h3>
        <div style="overflow-x: auto;">
          <table style="width: 100%; border-collapse: collapse; margin-top: 15px;">
            <thead>
              <tr style="background-color: #f8fafc; border-bottom: 2px solid #e2e8f0; text-align: left;">
                <th style="padding: 10px;">Nombre</th>
                <th style="padding: 10px; text-align: center;">Estatus</th>
                <th style="padding: 10px; text-align: center;">Calificación</th>
                <th style="padding: 10px; text-align: center;">Acciones</th>
              </tr>
            </thead>
            <tbody id="tabla-cuerpo-calculo"></tbody>
          </table>
        </div>
      </div>

      <!-- ================= VISTA: LENGUAJES ================= -->
      <div id="vista-lenguajes" style="display: none;">
        
        <!-- Promedio General Lenguajes -->
        <div style="background-color: #f0fdf4; border: 1px solid #bbf7d0; color: #166534; padding: 15px; border-radius: 8px; text-align: center; margin-bottom: 20px;">
          <h3 style="margin: 0; font-size: 16px; color: #15803d;">Promedio General del Grupo (Lenguajes)</h3>
          <p style="margin: 5px 0 0 0; font-size: 28px; font-weight: bold;" id="txt-promedio-lenguajes">--</p>
        </div>

        <div style="margin-bottom: 40px; background: #f8fafc; padding: 20px; border-radius: 12px; border: 1px solid #e2e8f0;">
          <div style="display: flex; gap: 10px; margin-bottom: 20px; justify-content: center;">
            <button id="btn-leng-calif" style="background: #10b981; color: white; border: none; padding: 10px 20px; border-radius: 8px; cursor: pointer; font-weight: bold;">Distribución de Calificaciones</button>
            <button id="btn-leng-tiempo" style="background: #e2e8f0; color: #475569; border: none; padding: 10px 20px; border-radius: 8px; cursor: pointer; font-weight: bold;">Tiempo por Alumno</button>
          </div>
          <div style="position: relative; height: 250px; width: 100%;">
            <canvas id="grafica-leng-calif"></canvas>
            <canvas id="grafica-leng-tiempo" style="display: none;"></canvas>
          </div>
        </div>

        <h3 style="color: #334155; font-size: 16px; margin-bottom: 15px;">Listado de Alumnos (Lenguajes)</h3>
        <div style="overflow-x: auto;">
          <table style="width: 100%; border-collapse: collapse; margin-top: 15px;">
            <thead>
              <tr style="background-color: #f8fafc; border-bottom: 2px solid #e2e8f0; text-align: left;">
                <th style="padding: 10px;">Nombre</th>
                <th style="padding: 10px; text-align: center;">Estatus</th>
                <th style="padding: 10px; text-align: center;">Calificación</th>
                <th style="padding: 10px; text-align: center;">Tiempo Usado</th>
                <th style="padding: 10px; text-align: center;">Acciones</th>
              </tr>
            </thead>
            <tbody id="tabla-cuerpo-lenguajes"></tbody>
          </table>
        </div>
      </div>

      <!-- ================= VISTA: SABERES ================= -->
      <div id="vista-saberes" style="display: none;">
        
        <!-- Promedio General Saberes -->
        <div style="background-color: #f0fdf4; border: 1px solid #bbf7d0; color: #166534; padding: 15px; border-radius: 8px; text-align: center; margin-bottom: 20px;">
          <h3 style="margin: 0; font-size: 16px; color: #15803d;">Promedio General del Grupo (Saberes)</h3>
          <p style="margin: 5px 0 0 0; font-size: 28px; font-weight: bold;" id="txt-promedio-saberes">--</p>
        </div>

        <div style="margin-bottom: 40px; background: #f8fafc; padding: 20px; border-radius: 12px; border: 1px solid #e2e8f0;">
          <div style="display: flex; gap: 10px; margin-bottom: 20px; justify-content: center;">
            <button id="btn-sab-calif" style="background: #8b5cf6; color: white; border: none; padding: 10px 20px; border-radius: 8px; cursor: pointer; font-weight: bold;">Distribución de Calificaciones</button>
            <button id="btn-sab-tiempo" style="background: #e2e8f0; color: #475569; border: none; padding: 10px 20px; border-radius: 8px; cursor: pointer; font-weight: bold;">Tiempo por Alumno</button>
          </div>
          <div style="position: relative; height: 250px; width: 100%;">
            <canvas id="grafica-sab-calif"></canvas>
            <canvas id="grafica-sab-tiempo" style="display: none;"></canvas>
          </div>
        </div>

        <h3 style="color: #334155; font-size: 16px; margin-bottom: 15px;">Listado de Alumnos (Saberes)</h3>
        <div style="overflow-x: auto;">
          <table style="width: 100%; border-collapse: collapse; margin-top: 15px;">
            <thead>
              <tr style="background-color: #f8fafc; border-bottom: 2px solid #e2e8f0; text-align: left;">
                <th style="padding: 10px;">Nombre</th>
                <th style="padding: 10px; text-align: center;">Estatus</th>
                <th style="padding: 10px; text-align: center;">Calificación</th>
                <th style="padding: 10px; text-align: center;">Tiempo Usado</th>
                <th style="padding: 10px; text-align: center;">Acciones</th>
              </tr>
            </thead>
            <tbody id="tabla-cuerpo-saberes"></tbody>
          </table>
        </div>
      </div>

      <!-- ================= VISTA: LENGUAJES SEM 1 ================= -->
      <div id="vista-lenguajes-sem1" style="display: none;">
        
        <!-- Promedio General Lenguajes Sem 1 -->
        <div style="background-color: #f0fdf4; border: 1px solid #bbf7d0; color: #166534; padding: 15px; border-radius: 8px; text-align: center; margin-bottom: 20px;">
          <h3 style="margin: 0; font-size: 16px; color: #15803d;">Promedio General del Grupo (Lenguajes - Semana 1)</h3>
          <p style="margin: 5px 0 0 0; font-size: 28px; font-weight: bold;" id="txt-promedio-lenguajes-sem1">--</p>
        </div>

        <div style="margin-bottom: 40px; background: #f8fafc; padding: 20px; border-radius: 12px; border: 1px solid #e2e8f0;">
          <div style="display: flex; gap: 10px; margin-bottom: 20px; justify-content: center;">
            <button id="btn-leng1-calif" style="background: #10b981; color: white; border: none; padding: 10px 20px; border-radius: 8px; cursor: pointer; font-weight: bold;">Distribución de Calificaciones</button>
            <button id="btn-leng1-tiempo" style="background: #e2e8f0; color: #475569; border: none; padding: 10px 20px; border-radius: 8px; cursor: pointer; font-weight: bold;">Tiempo por Alumno</button>
          </div>
          <div style="position: relative; height: 250px; width: 100%;">
            <canvas id="grafica-leng1-calif"></canvas>
            <canvas id="grafica-leng1-tiempo" style="display: none;"></canvas>
          </div>
        </div>

        <h3 style="color: #334155; font-size: 16px; margin-bottom: 15px;">Listado de Alumnos (Lenguajes - Semana 1)</h3>
        <div style="overflow-x: auto;">
          <table style="width: 100%; border-collapse: collapse; margin-top: 15px;">
            <thead>
              <tr style="background-color: #f8fafc; border-bottom: 2px solid #e2e8f0; text-align: left;">
                <th style="padding: 10px;">Nombre</th>
                <th style="padding: 10px; text-align: center;">Estatus</th>
                <th style="padding: 10px; text-align: center;">Calificación</th>
                <th style="padding: 10px; text-align: center;">Tiempo Usado</th>
                <th style="padding: 10px; text-align: center;">Acciones</th>
              </tr>
            </thead>
            <tbody id="tabla-cuerpo-lenguajes-sem1"></tbody>
          </table>
        </div>
      </div>

      <!-- ================= VISTA: MATEMÁTICAS SEM 1 ================= -->
      <div id="vista-matematicas-sem1" style="display: none;">
        
        <!-- Promedio General Matemáticas Sem 1 -->
        <div style="background-color: #f0fdf4; border: 1px solid #bbf7d0; color: #166534; padding: 15px; border-radius: 8px; text-align: center; margin-bottom: 20px;">
          <h3 style="margin: 0; font-size: 16px; color: #15803d;">Promedio General del Grupo (Matemáticas - Semana 1)</h3>
          <p style="margin: 5px 0 0 0; font-size: 28px; font-weight: bold;" id="txt-promedio-matematicas-sem1">--</p>
        </div>

        <div style="margin-bottom: 40px; background: #f8fafc; padding: 20px; border-radius: 12px; border: 1px solid #e2e8f0;">
          <div style="display: flex; gap: 10px; margin-bottom: 20px; justify-content: center;">
            <button id="btn-mat1-calif" style="background: #2563eb; color: white; border: none; padding: 10px 20px; border-radius: 8px; cursor: pointer; font-weight: bold;">Distribución de Calificaciones</button>
            <button id="btn-mat1-tiempo" style="background: #e2e8f0; color: #475569; border: none; padding: 10px 20px; border-radius: 8px; cursor: pointer; font-weight: bold;">Tiempo por Alumno</button>
          </div>
          <div style="position: relative; height: 250px; width: 100%;">
            <canvas id="grafica-mat1-calif"></canvas>
            <canvas id="grafica-mat1-tiempo" style="display: none;"></canvas>
          </div>
        </div>

        <h3 style="color: #334155; font-size: 16px; margin-bottom: 15px;">Listado de Alumnos (Matemáticas - Semana 1)</h3>
        <div style="overflow-x: auto;">
          <table style="width: 100%; border-collapse: collapse; margin-top: 15px;">
            <thead>
              <tr style="background-color: #f8fafc; border-bottom: 2px solid #e2e8f0; text-align: left;">
                <th style="padding: 10px;">Nombre</th>
                <th style="padding: 10px; text-align: center;">Estatus</th>
                <th style="padding: 10px; text-align: center;">Calificación</th>
                <th style="padding: 10px; text-align: center;">Tiempo Usado</th>
                <th style="padding: 10px; text-align: center;">Acciones</th>
              </tr>
            </thead>
            <tbody id="tabla-cuerpo-matematicas-sem1"></tbody>
          </table>
        </div>
      </div>

      <!-- ================= VISTA: CIENCIAS SEM 1 ================= -->
      <div id="vista-ciencias-sem1" style="display: none;">
        
        <!-- Promedio General Ciencias Sem 1 -->
        <div style="background-color: #f0fdf4; border: 1px solid #bbf7d0; color: #166534; padding: 15px; border-radius: 8px; text-align: center; margin-bottom: 20px;">
          <h3 style="margin: 0; font-size: 16px; color: #15803d;">Promedio General del Grupo (Ciencias Naturales - Semana 1)</h3>
          <p style="margin: 5px 0 0 0; font-size: 28px; font-weight: bold;" id="txt-promedio-ciencias-sem1">--</p>
        </div>

        <div style="margin-bottom: 40px; background: #f8fafc; padding: 20px; border-radius: 12px; border: 1px solid #e2e8f0;">
          <div style="display: flex; gap: 10px; margin-bottom: 20px; justify-content: center;">
            <button id="btn-cie1-calif" style="background: #8b5cf6; color: white; border: none; padding: 10px 20px; border-radius: 8px; cursor: pointer; font-weight: bold;">Distribución de Calificaciones</button>
            <button id="btn-cie1-tiempo" style="background: #e2e8f0; color: #475569; border: none; padding: 10px 20px; border-radius: 8px; cursor: pointer; font-weight: bold;">Tiempo por Alumno</button>
          </div>
          <div style="position: relative; height: 250px; width: 100%;">
            <canvas id="grafica-cie1-calif"></canvas>
            <canvas id="grafica-cie1-tiempo" style="display: none;"></canvas>
          </div>
        </div>

        <h3 style="color: #334155; font-size: 16px; margin-bottom: 15px;">Listado de Alumnos (Ciencias Naturales - Semana 1)</h3>
        <div style="overflow-x: auto;">
          <table style="width: 100%; border-collapse: collapse; margin-top: 15px;">
            <thead>
              <tr style="background-color: #f8fafc; border-bottom: 2px solid #e2e8f0; text-align: left;">
                <th style="padding: 10px;">Nombre</th>
                <th style="padding: 10px; text-align: center;">Estatus</th>
                <th style="padding: 10px; text-align: center;">Calificación</th>
                <th style="padding: 10px; text-align: center;">Tiempo Usado</th>
                <th style="padding: 10px; text-align: center;">Acciones</th>
              </tr>
            </thead>
            <tbody id="tabla-cuerpo-ciencias-sem1"></tbody>
          </table>
        </div>
      </div>

    </div>

    <!-- Modal Universal para Detalles -->
    <div id="modal-detalle" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); justify-content: center; align-items: center; padding: 20px; z-index: 2000;">
      <div style="background: white; padding: 30px; border-radius: 12px; max-width: 650px; width: 100%; max-height: 85vh; overflow-y: auto; box-shadow: 0 10px 25px rgba(0,0,0,0.2);">
        <h3 id="modal-titulo" style="margin-top: 0; color: #1e293b; border-bottom: 2px solid #f1f5f9; padding-bottom: 10px;">Desglose</h3>
        <div id="modal-contenido" style="margin: 20px 0;"></div>
        <button id="btn-cerrar-modal" style="width: 100%; background-color: #2563eb; color: white; border: none; padding: 12px; border-radius: 6px; font-weight: bold; cursor: pointer; margin-top: 20px;">Cerrar Panel de Detalles</button>
      </div>
    </div>

    <script>
      import { collection, getDocs, doc, getDoc, updateDoc, arrayUnion, setDoc } from "firebase/firestore";
      import { db } from "../firebase.js";

      // --- Pestañas ---
      const tabCalculo = document.getElementById('tab-calculo')!;
      const tabLenguajes = document.getElementById('tab-lenguajes')!;
      const tabSaberes = document.getElementById('tab-saberes')!;
      const tabLenguajesSem1 = document.getElementById('tab-lenguajes-sem1')!;
      const tabMatematicasSem1 = document.getElementById('tab-matematicas-sem1')!;
      const tabCienciasSem1 = document.getElementById('tab-ciencias-sem1')!;

      const vistaCalculo = document.getElementById('vista-calculo')!;
      const vistaLenguajes = document.getElementById('vista-lenguajes')!;
      const vistaSaberes = document.getElementById('vista-saberes')!;
      const vistaLenguajesSem1 = document.getElementById('vista-lenguajes-sem1')!;
      const vistaMatematicasSem1 = document.getElementById('vista-matematicas-sem1')!;
      const vistaCienciasSem1 = document.getElementById('vista-ciencias-sem1')!;

      function resetTabs() {
        [tabCalculo, tabLenguajes, tabSaberes, tabLenguajesSem1, tabMatematicasSem1, tabCienciasSem1].forEach(t => { 
          t.style.borderBottomColor = 'transparent'; 
          t.style.color = '#64748b'; 
        });
        [vistaCalculo, vistaLenguajes, vistaSaberes, vistaLenguajesSem1, vistaMatematicasSem1, vistaCienciasSem1].forEach(v => { 
          v.style.display = 'none'; 
        });
      }

      tabCalculo.addEventListener('click', () => { 
        resetTabs(); 
        vistaCalculo.style.display = 'block'; 
        tabCalculo.style.borderBottomColor = '#2563eb'; 
        tabCalculo.style.color = '#2563eb'; 
      });

      tabLenguajes.addEventListener('click', () => { 
        resetTabs(); 
        vistaLenguajes.style.display = 'block'; 
        tabLenguajes.style.borderBottomColor = '#10b981'; 
        tabLenguajes.style.color = '#10b981'; 
      });

      tabSaberes.addEventListener('click', () => { 
        resetTabs(); 
        vistaSaberes.style.display = 'block'; 
        tabSaberes.style.borderBottomColor = '#8b5cf6'; 
        tabSaberes.style.color = '#8b5cf6'; 
      });

      tabLenguajesSem1.addEventListener('click', () => {
        resetTabs();
        vistaLenguajesSem1.style.display = 'block';
        tabLenguajesSem1.style.borderBottomColor = '#10b981';
        tabLenguajesSem1.style.color = '#10b981';
      });

      tabMatematicasSem1.addEventListener('click', () => {
        resetTabs();
        vistaMatematicasSem1.style.display = 'block';
        tabMatematicasSem1.style.borderBottomColor = '#2563eb';
        tabMatematicasSem1.style.color = '#2563eb';
      });

      tabCienciasSem1.addEventListener('click', () => {
        resetTabs();
        vistaCienciasSem1.style.display = 'block';
        tabCienciasSem1.style.borderBottomColor = '#8b5cf6';
        tabCienciasSem1.style.color = '#8b5cf6';
      });

      // --- Modal ---
      const modalDetalle = document.getElementById('modal-detalle')!;
      const modalTitulo = document.getElementById('modal-titulo')!;
      const modalContenido = document.getElementById('modal-contenido')!;
      document.getElementById('btn-cerrar-modal')!.addEventListener('click', () => modalDetalle.style.display = 'none');

      // --- Controles Gráficas (Cálculo) ---
      const btnGeneral = document.getElementById('btn-vista-general')!;
      const btnOperaciones = document.getElementById('btn-vista-operaciones')!;
      const btnTiempos = document.getElementById('btn-vista-tiempos')!;
      const canvasGeneral = document.getElementById('graficaCalificaciones') as HTMLCanvasElement;
      const canvasOperaciones = document.getElementById('grafica-operaciones') as HTMLCanvasElement;
      const canvasTiempos = document.getElementById('grafica-tiempos') as HTMLCanvasElement;
