            matematicas_sem1: inputMatematicasSem1.value,
            ciencias_sem1: inputCienciasSem1.value
          }, { merge: true });
          
          alert("Fechas límite guardadas correctamente.");
        } catch (error) {
          console.error("Error al guardar:", error);
          alert("Hubo un error al guardar las fechas.");
        } finally {
          btnGuardarLimites.textContent = "Guardar Fechas";
          btnGuardarLimites.style.background = "#3b82f6";
        }
      });

      cargarLimites();
      cargarResultados();
    </script>
  </body>
</html>
