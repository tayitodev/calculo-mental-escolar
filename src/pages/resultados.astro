      // Función global para calificar respuestas abiertas desde el modal (Saberes)
      (window as any).toggleRespuestaAbierta = async (event: Event, alumnoId: string, reactivoIndex: number) => {
        const btn = event.target as HTMLButtonElement;
        const textoOriginal = btn.textContent;
        
        btn.textContent = '...';
        btn.disabled = true;

        try {
          const docRef = doc(db, "alumnos", alumnoId);
          const docSnap = await getDoc(docRef);
          if (!docSnap.exists()) return;

          const alumnoData = docSnap.data();
          const saberes = alumnoData.examen_saberes;

          const estadoActual = saberes.historial[reactivoIndex].esCorrecta;
          const nuevoEstado = !estadoActual;
          saberes.historial[reactivoIndex].esCorrecta = nuevoEstado;

          saberes.aciertos = saberes.historial.filter((h: any) => h.esCorrecta).length;
          saberes.totalPreguntas = saberes.historial.length;

          await updateDoc(docRef, { examen_saberes: saberes });

          btn.style.background = nuevoEstado ? '#16a34a' : '#e2e8f0';
          btn.style.color = nuevoEstado ? 'white' : '#475569';
          btn.textContent = nuevoEstado ? '✓ Correcta (+1)' : 'Marcar Correcta';
          btn.disabled = false;

          cargarResultados();
        } catch (err) {
          console.error("Error al actualizar respuesta:", err);
          btn.textContent = textoOriginal;
          btn.disabled = false;
        }
      };

