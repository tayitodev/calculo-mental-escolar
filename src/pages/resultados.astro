      async function cargarLimites() {
        try {
          const docRef = doc(db, "configuracion", "examenes");
          const docSnap = await getDoc(docRef);
          if (docSnap.exists()) {
            const data = docSnap.data();
            if (data.lenguajes_sem1) inputLenguajesSem1.value = data.lenguajes_sem1; 
            if (data.matematicas_sem1) inputMatematicasSem1.value = data.matematicas_sem1; 
            if (data.ciencias_sem1) inputCienciasSem1.value = data.ciencias_sem1; 
          }
        } catch (error) {
          console.error("Error al cargar límites:", error);
        }
      }

