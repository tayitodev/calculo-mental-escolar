---
// src/pages/lenguajes.astro
import examenData from '../data/lenguajes.json';

const lectura = examenData.lecturas[0];
const preguntas = examenData.preguntas;
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Examen - {examenData.materia}</title>
  </head>
  <body style="background-color: #f8fafc; font-family: sans-serif; margin: 0; padding-bottom: 80px;">

    <!-- Barra Superior Fija -->
    <div style="background: white; padding: 15px 20px; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1); position: sticky; top: 0; z-index: 100; display: flex; justify-content: space-between; align-items: center;">
      <h2 style="margin: 0; color: #1e293b; font-size: 18px;">Evaluación de {examenData.materia}</h2>
      <span style="color: #64748b; font-size: 14px; font-weight: bold;" id="nombre-alumno-display">Cargando...</span>
    </div>

    <div style="max-width: 800px; margin: 30px auto; padding: 0 20px;">
      
      <!-- Sección de Lectura -->
      <div style="background: white; padding: 30px; border-radius: 12px; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05); margin-bottom: 30px; border-left: 5px solid #3b82f6;">
        <h3 style="margin-top: 0; color: #2563eb; font-size: 20px;">📖 Lectura: {lectura.titulo}</h3>
        <p style="color: #334155; line-height: 1.8; font-size: 15px; white-space: pre-wrap;">{lectura.texto}</p>
      </div>

      <!-- Formulario del Examen -->
      <form id="form-lenguajes">
        
        {preguntas.map((p, index) => (
          <div style="background: white; padding: 25px; border-radius: 12px; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05); margin-bottom: 20px;">
            <p style="font-weight: bold; color: #1e293b; font-size: 16px; margin-top: 0; margin-bottom: 15px;">
              {index + 1}. {p.pregunta || p.instruccion}
            </p>

            {/* Opción Múltiple */}
            {p.tipo === 'opcion_multiple' && (
              <div style="display: flex; flex-direction: column; gap: 10px;">
                {Object.entries(p.opciones).map(([letra, texto]) => (
                  <label style="display: flex; align-items: center; gap: 10px; padding: 12px; border: 1px solid #e2e8f0; border-radius: 8px; cursor: pointer; transition: background 0.2s;">
                    <input type="radio" name={`pregunta_${p.id}`} value={letra} required style="transform: scale(1.2);" />
                    <span style="color: #475569; font-size: 15px;"><strong>{letra.toUpperCase()})</strong> {texto}</span>
                  </label>
                ))}
              </div>
            )}

            {/* Completar Texto (Input dentro del enunciado) */}
            {p.tipo === 'completar_texto' && (
              <div style="display: flex; flex-direction: column; gap: 15px;">
                {p.oraciones.map((oracion) => {
                  const partes = oracion.texto.split('_____');
                  return (
                    <div style="color: #334155; font-size: 15px; line-height: 1.8;">
                      {partes[0]}
                      <input type="text" name={`pregunta_${oracion.id}`} required style="padding: 6px 10px; border: 1px solid #cbd5e1; border-radius: 6px; font-size: 14px; width: 120px; text-align: center; margin: 0 5px;" autocomplete="off" />
                      {partes[1]}
                    </div>
                  );
                })}
              </div>
            )}

            {/* Verdadero o Falso (Placeholder en blanco) */}
            {p.tipo === 'verdadero_falso' && (
              <div style="display: flex; flex-direction: column; gap: 15px;">
                {p.afirmaciones.map((afirmacion) => (
                  <div style="display: flex; justify-content: space-between; align-items: center; gap: 15px; border-bottom: 1px solid #f1f5f9; padding-bottom: 10px;">
                    <label style="color: #334155; font-size: 14px; flex: 1;">{afirmacion.texto}</label>
                    <input type="text" name={`pregunta_${afirmacion.id}`} required maxlength="1" placeholder="" style="padding: 10px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 16px; font-weight: bold; width: 50px; text-align: center; text-transform: uppercase;" autocomplete="off" />
                  </div>
                ))}
              </div>
            )}

            {/* Ordenamiento */}
            {p.tipo === 'ordenamiento' && (
              <div style="display: flex; flex-direction: column; gap: 15px;">
                {p.elementos.map((elemento) => (
                  <div style="display: flex; align-items: center; gap: 15px;">
                    <input type="number" name={`pregunta_${elemento.id}`} required min="1" max="5" placeholder="#" style="padding: 10px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 16px; font-weight: bold; width: 60px; text-align: center;" />
                    <label style="color: #334155; font-size: 14px;">{elemento.texto}</label>
                  </div>
                ))}
              </div>
            )}

          </div>
        ))}

        <div style="text-align: center; margin-top: 40px;">
          <button type="submit" id="btn-enviar" style="background-color: #10b981; color: white; border: none; padding: 16px 40px; font-size: 18px; border-radius: 8px; font-weight: bold; cursor: pointer; box-shadow: 0 4px 6px -1px rgba(16, 185, 129, 0.4);">
            Enviar Examen
          </button>
        </div>

      </form>
    </div>

    <!-- Modal de Instrucciones Flotante -->
    <div id="modal-instrucciones" style="display: flex; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(15, 23, 42, 0.85); justify-content: center; align-items: center; padding: 20px; z-index: 1000;">
      <div style="background: white; padding: 35px; border-radius: 16px; max-width: 450px; width: 100%; box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1); text-align: left;">
        <h2 style="color: #b45309; margin-top: 0; text-align: center; font-size: 22px;">⚠️ Aviso Importante</h2>
        <p style="color: #475569; font-size: 14px; margin-bottom: 20px; text-align: center;">Lee con atención antes de comenzar:</p>
        
        <ul style="color: #334155; font-size: 14px; line-height: 1.6; padding-left: 20px; margin-bottom: 25px;">
          <li style="margin-bottom: 10px;">Este examen requiere lectura. Tómate tu tiempo para comprender el texto.</li>
          <li style="margin-bottom: 10px;"><strong>NO cierres ni recargues esta página</strong> por ningún motivo. Si lo haces, tus respuestas se borrarán y perderás tu oportunidad.</li>
          <li>Al finalizar, debes hacer clic en el botón verde de "Enviar Examen" al fondo de la página.</li>
        </ul>

        <button id="btn-comenzar" style="width: 100%; background-color: #2563eb; color: white; border: none; padding: 14px; font-size: 16px; border-radius: 8px; font-weight: bold; cursor: pointer; text-align: center;">
          ¡Entendido, Comenzar Examen!
        </button>
      </div>
    </div>

    <script id="data-preguntas" type="application/json" set:html={JSON.stringify(preguntas)}></script>

    <script>
      import { doc, updateDoc } from "firebase/firestore";
      import { db } from "../firebase.js";

      const alumnoId = sessionStorage.getItem('alumnoActivo');
      const alumnoNombre = sessionStorage.getItem('nombreActivo');

      if (!alumnoId || !alumnoNombre) {
        window.location.replace('/');
      }
      document.getElementById('nombre-alumno-display')!.textContent = alumnoNombre;

      // Variables para el cronómetro silencioso y seguridad
      let tiempoInicio: number;
      const modal = document.getElementById('modal-instrucciones') as HTMLElement;
      const btnComenzar = document.getElementById('btn-comenzar') as HTMLButtonElement;

      // Alarma Anti-Recarga (Se desactiva cuando mandan el form)
      const advertenciaSalida = (e: BeforeUnloadEvent) => {
        e.preventDefault();
        e.returnValue = 'Si sales de la página perderás tu progreso.';
      };

      btnComenzar.addEventListener('click', () => {
        modal.style.display = 'none';
        tiempoInicio = Date.now();
        window.addEventListener('beforeunload', advertenciaSalida);
      });

      const form = document.getElementById('form-lenguajes') as HTMLFormElement;
      
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        
        // Apagamos la alarma antes de guardar para que no bloquee el redireccionamiento
        window.removeEventListener('beforeunload', advertenciaSalida);
        
        const tiempoFin = Date.now();
        const segundosTardados = Math.floor((tiempoFin - tiempoInicio) / 1000);

        const preguntasText = document.getElementById('data-preguntas')!.textContent;
        const preguntasJSON = JSON.parse(preguntasText!);

        let aciertos = 0;
        let totalCalificables = 0;
        let historial: any[] = [];

        preguntasJSON.forEach((p: any) => {
          if (p.tipo === 'opcion_multiple') {
            totalCalificables++;
            const input = document.querySelector(`input[name="pregunta_${p.id}"]:checked`) as HTMLInputElement;
            const valor = input ? input.value : "";
            const esCorrecta = valor === p.respuestaCorrecta;
            if (esCorrecta) aciertos++;
            historial.push({ id: p.id, tipo: p.tipo, respuestaUsuario: valor, correcta: p.respuestaCorrecta, esCorrecta });
          
          } else if (p.tipo === 'completar_texto') {
            p.oraciones.forEach((oracion: any) => {
              totalCalificables++;
              const input = document.querySelector(`input[name="pregunta_${oracion.id}"]`) as HTMLInputElement;
              const valor = input ? input.value.trim().toLowerCase() : "";
              const esCorrecta = valor === oracion.respuestaCorrecta.toLowerCase();
              if (esCorrecta) aciertos++;
              historial.push({ id: oracion.id, tipo: 'texto', respuestaUsuario: input ? input.value : "", correcta: oracion.respuestaCorrecta, esCorrecta });
            });
          
          } else if (p.tipo === 'verdadero_falso') {
            p.afirmaciones.forEach((afirmacion: any) => {
              totalCalificables++;
              const input = document.querySelector(`input[name="pregunta_${afirmacion.id}"]`) as HTMLInputElement;
              const valor = input ? input.value.trim().toUpperCase() : "";
              const esCorrecta = valor === afirmacion.respuestaCorrecta.toUpperCase();
              if (esCorrecta) aciertos++;
              historial.push({ id: afirmacion.id, tipo: 'vf', respuestaUsuario: input ? input.value : "", correcta: afirmacion.respuestaCorrecta, esCorrecta });
            });

          } else if (p.tipo === 'ordenamiento') {
            p.elementos.forEach((elemento: any) => {
              totalCalificables++;
              const input = document.querySelector(`input[name="pregunta_${elemento.id}"]`) as HTMLInputElement;
              const valor = input ? parseInt(input.value) : 0;
              const esCorrecta = valor === elemento.respuestaCorrecta;
              if (esCorrecta) aciertos++;
              historial.push({ id: elemento.id, tipo: 'orden', respuestaUsuario: valor, correcta: elemento.respuestaCorrecta, esCorrecta });
            });
          }
        });

        const btnEnviar = document.getElementById('btn-enviar') as HTMLButtonElement;
        btnEnviar.textContent = "Guardando...";
        btnEnviar.disabled = true;

        try {
          const alumnoRef = doc(db, "alumnos", alumnoId!);
          await updateDoc(alumnoRef, {
            examen_lenguajes: {
              completado: true,
              aciertos: aciertos,
              totalPreguntas: totalCalificables,
              tiempoSegundos: segundosTardados,
              historial: historial
            }
          });

          alert("¡Tus respuestas han sido guardadas correctamente! Regresando al portal...");
          window.location.replace('/dashboard');
        } catch (error) {
          console.error("Error al guardar:", error);
          alert("Hubo un error al guardar. Inténtalo de nuevo.");
          btnEnviar.textContent = "Enviar Examen";
          btnEnviar.disabled = false;
          // Si falla, volvemos a prender la alarma por si intentan salir
          window.addEventListener('beforeunload', advertenciaSalida);
        }
      });
    </script>
  </body>
</html>