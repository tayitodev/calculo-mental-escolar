---
// src/pages/dashboard.astro
---
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Portal del Alumno</title>
  </head>
  <body style="background-color: #f8fafc; font-family: sans-serif; display: flex; justify-content: center; align-items: center; min-height: 100vh; margin: 0;">

    <div style="background: white; padding: 40px; border-radius: 16px; box-shadow: 0 10px 25px rgba(0,0,0,0.08); width: 100%; max-width: 500px;">
      <div style="text-align: center; margin-bottom: 30px;">
        <h2 style="color: #1e293b; margin: 0 0 10px 0; font-size: 24px;">¡Hola, <span id="nombre-alumno"></span>! 👋</h2>
        <p style="color: #64748b; font-size: 15px; margin: 0;">Selecciona la evaluación que vas a realizar hoy.</p>
      </div>

      <div style="display: flex; flex-direction: column; gap: 20px;">
        <!-- Tarjeta: Cálculo Mental -->
        <div style="border: 2px solid #e2e8f0; border-radius: 12px; padding: 20px; display: flex; justify-content: space-between; align-items: center;">
          <div>
            <h3 style="margin: 0 0 5px 0; color: #0f172a;">Cálculo Mental</h3>
            <p style="margin: 0; color: #64748b; font-size: 14px;">10 operaciones matemáticas con tiempo límite.</p>
          </div>
          <div id="accion-calculo">Cargando...</div>
        </div>

        <!-- Tarjeta: Examen Lenguajes -->
        <div style="border: 2px solid #e2e8f0; border-radius: 12px; padding: 20px; display: flex; justify-content: space-between; align-items: center;">
          <div>
            <h3 style="margin: 0 0 5px 0; color: #0f172a;">Examen Lenguajes</h3>
            <p style="margin: 0; color: #64748b; font-size: 14px;">Evaluación de opción múltiple y respuesta abierta.</p>
          </div>
          <div id="accion-lenguajes">Cargando...</div>
        </div>
      </div>

      <!-- TARJETA DE SABERES Y PENSAMIENTO CIENTÍFICO -->
        <div style="background: white; padding: 25px; border-radius: 12px; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05); text-align: center; border-top: 4px solid #8b5cf6;">
        <h3 style="color: #1e293b; margin-top: 0;">Saberes y Pensamiento Científico</h3>
        <p style="color: #64748b; font-size: 14px; margin-bottom: 20px;">Matemáticas y Ciencias Naturales</p>
        
        {alumno.examen_saberes?.completado ? (
            <div style="background: #f1f5f9; color: #64748b; padding: 12px; border-radius: 8px; font-weight: bold;">
            ✅ Examen Completado
            </div>
        ) : (
            <a href="/saberes" style="display: block; background: #8b5cf6; color: white; text-decoration: none; padding: 12px; border-radius: 8px; font-weight: bold; box-shadow: 0 4px 6px -1px rgba(139, 92, 246, 0.4);">
            Comenzar Examen
            </a>
        )}
        </div>

      <div style="text-align: center; margin-top: 30px;">
        <button id="btn-cerrar-sesion" style="background: none; border: none; color: #ef4444; font-weight: bold; cursor: pointer; font-size: 15px; text-decoration: underline;">
          Cerrar Sesión
        </button>
      </div>
    </div>

    <script>
      import { doc, getDoc } from "firebase/firestore";
      import { db } from "../firebase.js";

      const alumnoId = sessionStorage.getItem('alumnoActivo');
      const alumnoNombre = sessionStorage.getItem('nombreActivo');

      if (!alumnoId) { window.location.replace('/'); }
      document.getElementById('nombre-alumno')!.textContent = alumnoNombre;

      document.getElementById('btn-cerrar-sesion')!.addEventListener('click', () => {
        sessionStorage.clear();
        window.location.replace('/');
      });

      async function revisarEstatus() {
        try {
          const docRef = doc(db, "alumnos", alumnoId!);
          const docSnap = await getDoc(docRef);
          
          if (docSnap.exists()) {
            const data = docSnap.data();
            
            // Lógica Cálculo Mental
            const accionCalculo = document.getElementById('accion-calculo')!;
            if (data.completado) {
              accionCalculo.innerHTML = '<span style="background: #dcfce7; color: #166534; padding: 6px 12px; border-radius: 20px; font-weight: bold; font-size: 14px;">Completado ✅</span>';
            } else {
              accionCalculo.innerHTML = '<a href="/examen" style="background: #2563eb; color: white; padding: 10px 20px; border-radius: 8px; text-decoration: none; font-weight: bold;">Ingresar</a>';
            }

            // Lógica Lenguajes (Aquí está el candado que faltaba)
            const accionLenguajes = document.getElementById('accion-lenguajes')!;
            if (data.examen_lenguajes && data.examen_lenguajes.completado) {
              accionLenguajes.innerHTML = '<span style="background: #dcfce7; color: #166534; padding: 6px 12px; border-radius: 20px; font-weight: bold; font-size: 14px;">Completado ✅</span>';
            } else {
              accionLenguajes.innerHTML = '<a href="/lenguajes" style="background: #2563eb; color: white; padding: 10px 20px; border-radius: 8px; text-decoration: none; font-weight: bold;">Ingresar</a>';
            }
          }
        } catch (error) {
          console.error("Error al obtener datos:", error);
        }
      }
      revisarEstatus();
    </script>
  </body>
</html>