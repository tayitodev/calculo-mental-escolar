---
// src/pages/index.astro
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Portal Escolar - 5to Grado</title>
  </head>
  <body style="background-color: #f4f6f9; font-family: sans-serif; display: flex; justify-content: center; align-items: center; min-height: 100vh; margin: 0;">

    <div style="background: white; padding: 35px 40px; border-radius: 16px; box-shadow: 0 10px 25px rgba(0,0,0,0.08); width: 100%; max-width: 400px; text-align: center;">
      
      <div style="margin-bottom: 20px;">
        <img src="/logo-escuela.png" alt="Logo Escuela" style="max-height: 170px; width: auto; object-fit: contain;" onerror="this.style.display='none'" />
      </div>

      <h2 style="color: #1e293b; margin: 0 0 8px 0; font-size: 24px;">Portal del Alumno</h2>
      <p style="color: #64748b; font-size: 14px; margin-bottom: 25px;">Selecciona tu nombre e ingresa tu PIN para entrar.</p>

      <form id="form-login">
        <div style="margin-bottom: 20px; text-align: left;">
          <label for="select-alumno" style="display: block; font-size: 13px; font-weight: bold; color: #475569; margin-bottom: 6px;">Alumno:</label>
          <select id="select-alumno" required style="width: 100%; padding: 12px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 14px; background: #fff; color: #1e293b;">
            <option value="" disabled selected>Cargando lista de alumnos...</option>
          </select>
        </div>

        <div style="margin-bottom: 25px; text-align: left;">
          <label for="input-pin" style="display: block; font-size: 13px; font-weight: bold; color: #475569; margin-bottom: 6px;">PIN de Acceso (4 dígitos):</label>
          <input type="password" id="input-pin" maxlength="4" placeholder="••••" required style="width: 100%; padding: 12px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 16px; text-align: center; letter-spacing: 6px;" />
        </div>

        <button type="submit" style="width: 100%; background-color: #2563eb; color: white; border: none; padding: 14px; font-size: 16px; border-radius: 8px; cursor: pointer; font-weight: bold; transition: background 0.2s;">
          Entrar al Portal
        </button>
      </form>
      
      <p id="mensaje-error" style="color: #ef4444; font-size: 13px; margin-top: 15px; display: none; background: #fef2f2; padding: 10px; border-radius: 6px;"></p>

      <!-- Enlace discreto para el acceso de la maestra -->
      <div style="margin-top: 25px; border-top: 1px solid #f1f5f9; padding-top: 15px;">
        <button id="btn-maestra" style="background: none; border: none; color: #64748b; font-size: 13px; cursor: pointer; text-decoration: underline;">
          Acceso Docente (Panel de Resultados)
        </button>
      </div>

    </div>

  <!-- Modal de Acceso Docente -->
    <div id="modal-docente" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(15, 23, 42, 0.7); justify-content: center; align-items: center; padding: 20px; z-index: 1000;">
      <div style="background: white; padding: 35px; border-radius: 16px; max-width: 350px; width: 100%; box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1); text-align: center;">
        <h2 style="color: #1e293b; margin-top: 0; font-size: 20px;">Acceso Docente</h2>
        <p style="color: #64748b; font-size: 14px; margin-bottom: 20px;">Ingresa la contraseña para ver el panel de resultados.</p>
        
        <input type="password" id="input-password-docente" placeholder="••••••••" style="width: 100%; padding: 12px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 16px; text-align: center; margin-bottom: 15px; box-sizing: border-box;" />
        <p id="error-docente" style="color: #ef4444; font-size: 13px; margin-top: 0; margin-bottom: 15px; display: none;">Contraseña incorrecta.</p>

        <div style="display: flex; gap: 10px;">
          <button id="btn-cerrar-docente" style="flex: 1; background-color: #e2e8f0; color: #475569; border: none; padding: 12px; font-size: 14px; border-radius: 8px; font-weight: bold; cursor: pointer;">Cancelar</button>
          <button id="btn-entrar-docente" style="flex: 1; background-color: #2563eb; color: white; border: none; padding: 12px; font-size: 14px; border-radius: 8px; font-weight: bold; cursor: pointer;">Entrar</button>
        </div>
      </div>
    </div>

    <script>
      import { collection, getDocs } from "firebase/firestore";
      import { db } from "../firebase.js";

      const selectAlumno = document.getElementById('select-alumno') as HTMLSelectElement;
      let alumnosMap = new Map();

      async function cargarAlumnos() {
        if (sessionStorage.getItem('alumnoActivo')) {
          window.location.replace('/dashboard');
          return;
        }

        try {
          const querySnapshot = await getDocs(collection(db, "alumnos"));
          selectAlumno.innerHTML = '<option value="" disabled selected>Selecciona tu nombre...</option>';
          
          let lista = [];
          querySnapshot.forEach((docSnap) => {
            lista.push({ id: docSnap.id, ...docSnap.data() });
          });
          lista.sort((a, b) => a.nombre.localeCompare(b.nombre));

          lista.forEach((alumno) => {
            alumnosMap.set(alumno.id, alumno);
            const option = document.createElement('option');
            option.value = alumno.id;
            option.textContent = alumno.nombre;
            selectAlumno.appendChild(option);
          });
        } catch (error) {
          console.error("Error al cargar alumnos:", error);
          selectAlumno.innerHTML = '<option value="" disabled selected>Error al cargar la lista</option>';
        }
      }

      cargarAlumnos();

      const formLogin = document.getElementById('form-login') as HTMLFormElement;
      const inputPin = document.getElementById('input-pin') as HTMLInputElement;
      const mensajeError = document.getElementById('mensaje-error') as HTMLElement;
      const btnMaestra = document.getElementById('btn-maestra') as HTMLButtonElement;

      formLogin.addEventListener('submit', (e) => {
        e.preventDefault();
        const idSeleccionadoTemp = selectAlumno.value;
        const pinIngresado = inputPin.value.trim();

        const alumnoData = alumnosMap.get(idSeleccionadoTemp);

        if (!alumnoData) {
          mensajeError.textContent = "Por favor selecciona un alumno.";
          mensajeError.style.display = "block";
          return;
        }

        if (alumnoData.pin !== pinIngresado) {
          mensajeError.textContent = "PIN incorrecto. Inténtalo de nuevo.";
          mensajeError.style.display = "block";
          return;
        }

        // Acceso limpio y directo al Portal
        sessionStorage.setItem('alumnoActivo', idSeleccionadoTemp);
        sessionStorage.setItem('nombreActivo', alumnoData.nombre);
        window.location.replace('/dashboard');
      });

      // Lógica protegida para el acceso de la maestra (Modal)
      const modalDocente = document.getElementById('modal-docente') as HTMLElement;
      const inputPasswordDocente = document.getElementById('input-password-docente') as HTMLInputElement;
      const btnCerrarDocente = document.getElementById('btn-cerrar-docente') as HTMLButtonElement;
      const btnEntrarDocente = document.getElementById('btn-entrar-docente') as HTMLButtonElement;
      const errorDocente = document.getElementById('error-docente') as HTMLElement;

      btnMaestra.addEventListener('click', () => {
        inputPasswordDocente.value = '';
        errorDocente.style.display = 'none';
        modalDocente.style.display = 'flex';
        inputPasswordDocente.focus();
      });

      btnCerrarDocente.addEventListener('click', () => {
        modalDocente.style.display = 'none';
      });

      btnEntrarDocente.addEventListener('click', () => {
        const password = inputPasswordDocente.value;
        
        if (password === "MaestraBrenda24") { 
          window.location.href = '/resultados';
        } else {
          errorDocente.style.display = 'block';
        }
      });
    </script>
  </body>
</html>